# vlm.env.example — copy to vlm.env (vlm_bridge/) and adjust if needed.
# vlm.env is gitignored and will never be committed.
#
# Used by ask_vlm.py: bridges image understanding to a vision LLM API
# (default: Qwen3.8-Max via Volcengine gateway, OpenAI-compatible).
#
# Get the key from ~/.workbuddy/models.json (same key works for the
# Volcengine gateway entries). If a model is ever disabled or the key
# rotates, update it there first, then sync here.

# OpenAI-compatible chat endpoint (no trailing slash)
export VLM_API_URL="https://st8tp3ajl0df3n8b8l8qu.apigateway-cn-beijing.volceapi.com/v1/chat/completions"
export VLM_API_KEY="d8a875f9-9b47-4c34-a94f-a7a2844321aa"
export VLM_MODEL="qwen3.8-max"

# Fallback model if the primary one errors out (set empty to disable)
export VLM_FALLBACK_MODEL="doubao-seed-2.1-pro"

# Max output tokens per request
export VLM_MAX_TOKENS="1024"

# Optional corporate proxy (leave empty for direct connection).
# If set, ask_vlm.py routes HTTPS through it.
export VLM_HTTP_PROXY=""
